function InitCommonAccordion(root) {
    const wrappers = root.querySelectorAll(".common_accordion");
    const cleanupFns = [];
    wrappers.forEach((wrapper)=>{
        const items = Array.from(wrapper.querySelectorAll(".fundacc_item"));
        if (!items.length) return;
        const closeAll = ()=>{
            items.forEach((item)=>{
                item.classList.remove("fundacc_active");
                const panel = item.querySelector(".fundacc_panel");
                if (panel) panel.style.height = "0px";
            });
        };
        items.forEach((item)=>{
            const heading = item.querySelector(".fundacc_heading");
            const panel = item.querySelector(".fundacc_panel");
            const inner = item.querySelector(".fundacc_inner");
            if (!heading || !panel || !inner) return;
            const onClick = (e)=>{
                e.preventDefault();
                const isActive = item.classList.contains("fundacc_active");
                // Close all items in this wrapper
                closeAll();
                // Open clicked item if it was closed
                if (!isActive) {
                    item.classList.add("fundacc_active");
                    panel.style.height = inner.scrollHeight + "px";
                }
            };
            const onKeyDown = (e)=>{
                if (e.key === "Enter" || e.key === " ") {
                    onClick(e);
                }
            };
            heading.addEventListener("click", onClick);
            heading.addEventListener("keydown", onKeyDown);
            // Accessibility
            heading.setAttribute("role", "button");
            heading.setAttribute("tabindex", "0");
            cleanupFns.push(()=>{
                heading.removeEventListener("click", onClick);
                heading.removeEventListener("keydown", onKeyDown);
            });
        });
        // Keep open panel height correct on window resize
        const onResize = ()=>{
            const activeItem = wrapper.querySelector(".fundacc_item.fundacc_active");
            if (!activeItem) return;
            const panel = activeItem.querySelector(".fundacc_panel");
            const inner = activeItem.querySelector(".fundacc_inner");
            if (panel && inner) {
                panel.style.height = inner.scrollHeight + "px";
            }
        };
        window.addEventListener("resize", onResize);
        cleanupFns.push(()=>window.removeEventListener("resize", onResize));
    });
    return ()=>{
        cleanupFns.forEach((fn)=>fn());
    };
}
_c = InitCommonAccordion;
var _c;
